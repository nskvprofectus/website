---
layout: components/page.njk
---

<div class="markdown">
    <h1> The board of {{ board.year }} </h1>
</div>

<div class="flex items-center flex-col">
    <img 
        class="w-full"
        src="{{ board.folder }}/{{ board.image }}"
    >
    </img>

    <div class="w-full py-5 gap-8 flex flex-wrap justify-center px-4">
        {% for member in collections.board_members %}
            <div>
                <div class="relative aspect-[3/4] h-board-items-height overflow-hidden">
                    <img 
                        class="object-cover w-full h-full"
                        src="{{ member.data.image }}"
                    >
                    </img>
                </div>
                <div class="markdown">
                    <h2> {{ member.data.name }} </h2>
                    <p class="italic"> {{ member.data.role }} </p>
                    {{ member.content | safe }}
                </div>
            </div>
        {% endfor %}
    </div>
</div>

